# Export these variables in your shell. This file is documentation, not auto-loaded.
VISION_DATABASE_URL=sqlite:///.runtime/pilot.db
VISION_DATA_DIR=.runtime
VISION_API_TOKEN=replace-with-a-long-random-token
# Model calls are disabled by default; enable only with authorized credentials.
VISION_ENABLE_MODELS=0
VISION_MODEL=gpt-6.1-sol
